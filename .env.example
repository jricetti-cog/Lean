# LEAN compose settings. Copy to .env and change what you need; every value below is the default that
# docker-compose.yml uses when the variable is unset. Change every password outside local development.
# Ports are always published on 127.0.0.1 only.

# Compose
COMPOSE_PROJECT_NAME=lean
# Uncomment to make a plain `docker compose up` start the infrastructure.
# COMPOSE_PROFILES=infra

# Images
RABBITMQ_IMAGE=rabbitmq:3.13.7-management
POSTGRES_IMAGE=postgres:17.12-alpine
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
SEED_IMAGE=alpine:3.22.8

# RabbitMQ (topology: docs/architecture/contracts/topology/)
RABBITMQ_USER=lean
RABBITMQ_PASSWORD=lean-dev-rabbitmq
RABBITMQ_VHOST=lean
RABBITMQ_ERLANG_COOKIE=lean-dev-erlang-cookie
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# PostgreSQL 17: superuser plus one login role per owning service (database name = role name)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lean-dev-postgres
POSTGRES_JOBS_PASSWORD=lean-dev-jobs
POSTGRES_RESULTS_PASSWORD=lean-dev-results
POSTGRES_GATEWAY_PASSWORD=lean-dev-gateway
POSTGRES_MARKETDATA_PASSWORD=lean-dev-marketdata
POSTGRES_PORT=5432

# MinIO: root credentials (console/admin only) and the account services use
MINIO_ROOT_USER=lean-admin
MINIO_ROOT_PASSWORD=lean-dev-minio-admin
MINIO_SERVICE_ACCESS_KEY=lean-services
MINIO_SERVICE_SECRET_KEY=lean-dev-minio-services
MINIO_BUCKET_ALGORITHMS=lean-algorithms
MINIO_BUCKET_RESULTS=lean-results
MINIO_BUCKET_REPORTS=lean-reports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# lean-data volume owner: the uid/gid of the `app` user in the service images (Services/Dockerfile)
LEAN_DATA_UID=1654
LEAN_DATA_GID=1654

# Results service (plan step s3.2): results API on 127.0.0.1:RESULTS_PORT
RESULTS_PORT=5083

# Report service (plan step s3.3): report API on 127.0.0.1:REPORT_PORT
REPORT_PORT=5084

# Research (plan step s3.4): JupyterLab on 127.0.0.1:RESEARCH_PORT; service base URLs injected into notebooks
RESEARCH_PORT=8888
LEAN_MARKET_DATA_URL=http://market-data:8080
LEAN_RESULTS_URL=http://results:8080

# ToolBox one-shot jobs (plan step s3.4): staging seed (`all` or space-separated data paths), dry run, converter inputs (/input)
TOOLBOX_SEED=all
TOOLBOX_DRY_RUN=0
TOOLBOX_INPUT_DIR=./deploy/compose/toolbox-input

# API gateway (plan step s4.5): public API on 127.0.0.1:GATEWAY_PORT. GATEWAY_API_KEY is the dev key
# (send it as `X-Api-Key` or `Authorization: Bearer`); set GATEWAY_JWT_AUTHORITY (OIDC) or
# GATEWAY_JWT_SIGNING_KEY (HS256) to also accept identity-provider tokens.
GATEWAY_PORT=5080
GATEWAY_API_KEY=lean-dev-api-key
GATEWAY_API_KEY_USER=dev
GATEWAY_JWT_AUTHORITY=
GATEWAY_JWT_AUDIENCE=
GATEWAY_JWT_SIGNING_KEY=
GATEWAY_RATE_LIMIT=120
GATEWAY_RATE_WINDOW_SECONDS=60
