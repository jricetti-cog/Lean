{
  "uid": "lean-postgresql",
  "title": "LEAN / PostgreSQL health",
  "description": "PostgreSQL health from postgres-exporter: availability, connections, transactions, cache hit ratio, locks and database sizes (plan step s5.3).",
  "tags": [
    "lean",
    "postgresql",
    "infra"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "utc",
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "lean"
      ],
      "asDropdown": true,
      "title": "LEAN dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
